# Nginx Reverse Proxy Configuration for Ubuntu Contabo VPS
# Place this file in /etc/nginx/sites-available/iptv-relay
# Then run: sudo ln -s /etc/nginx/sites-available/iptv-relay /etc/nginx/sites-enabled/
# And reload Nginx: sudo systemctl reload nginx

server {
    listen 80;
    server_name YOUR_DOMAIN_OR_IP; # e.g. iptv.yourdomain.com or 194.163.xxx.xxx

    # Buffer settings for fast transfer of large M3U playlists
    proxy_buffers 16 64k;
    proxy_buffer_size 128k;
    proxy_read_timeout 300s;
    proxy_connect_timeout 60s;
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
