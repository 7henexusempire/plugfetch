# Nginx Reverse Proxy Configuration Example for Ubuntu Contabo VPS
# Place in /etc/nginx/sites-available/iptv-relay and link to /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name YOUR_DOMAIN_OR_IP; # e.g. iptv.yourdomain.com or 194.163.xxx.xxx

    # Optional: Increase proxy buffer sizes for large M3U playlist downloads
    proxy_buffers 16 32k;
    proxy_buffer_size 64k;
    proxy_read_timeout 120s;
    proxy_connect_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
