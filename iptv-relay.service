[Unit]
Description=IPTV Multi-Playlist Relay Studio Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/iptv-relay
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/var/www/iptv-relay/data

[Install]
WantedBy=multi-user.target
